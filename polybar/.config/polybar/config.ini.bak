; ============================================================
;  Polybar Config - Highlight Focused Only
; ============================================================

[colors]
; Catppuccin Mocha Palette
base = #1e1e2e
mantle = #181825
crust = #11111b
text = #cdd6f4
subtext0 = #a6adc8
subtext1 = #bac2de
surface0 = #313244
surface1 = #45475a
surface2 = #585b70
overlay0 = #6c7086
overlay1 = #7f849c
overlay2 = #9399b2
blue = #89b4fa
lavender = #b4befe
sapphire = #74c7ec
sky = #89dceb
teal = #94e2d5
green = #a6e3a1
yellow = #f9e2af
peach = #fab387
maroon = #eba0ac
red = #f38ba8
mauve = #cba6f7
pink = #f5c2e7
flamingo = #f2cdcd
rosewater = #f5e0dc
transparent = #00000000

[bar/main]
width = 100%
height = 24pt
radius = 10

; 状态栏整体背景
background = ${colors.base}
foreground = ${colors.text}

line-size = 0
border-size = 2

; 恢复默认的内边距，因为不再是贴边的色块了
padding-left = 1
padding-right = 1
module-margin = 1

font-0 = "Maple Mono NF CN:size=13;3"
font-1 = "Maple Mono NF CN:style=Bold:size=13;3"
font-2 = "Source Han Sans SC:style=Regular:size=11;2"
font-3 = "Font Awesome 6 Free:style=Solid:size=10;2"

modules-left = i3
modules-center = date
modules-right = tray

cursor-click = pointer
cursor-scroll = ns-resize
enable-ipc = true



; ============================================================
;  MODULE: i3 Workspaces (纯净版：只显中文，无数字，无加粗)
; ============================================================

[module/i3]
type = internal/i3

pin-workspaces = true
strip-wsnumbers = true
index-sort = true

ws-icon-0 = 1;壹
ws-icon-1 = 2;贰
ws-icon-2 = 3;叁
ws-icon-3 = 4;肆
ws-icon-4 = 5;伍
ws-icon-5 = 6;陆
ws-icon-6 = 7;柒
ws-icon-7 = 8;捌
ws-icon-8 = 9;玖
ws-icon-9 = 10;拾
ws-icon-default = 

; --- 核心修改 1: 加入 <label-mode> ---
; 这样 Polybar 才知道要显示 "resize" 这个字样
format = <label-state> <label-mode>

format-background = ${colors.base}
format-padding = 0

; --- 核心修改 2: 定义模式提示的样式 (红色背景) ---
label-mode = %mode%
; 背景设为红色，文字设为深色
label-mode-background = ${colors.red}
label-mode-foreground = ${colors.base}
label-mode-padding = 1
; 稍微加粗，起警示作用
label-mode-font = 2

; --- 以下是你之前的配置 (保持不变) ---
label-focused = %icon%
label-focused-foreground = ${colors.base}
label-focused-background = ${colors.mauve}
label-focused-padding = 1
label-focused-font = 1

label-unfocused = %icon%
label-unfocused-foreground = ${colors.overlay0}
label-unfocused-background = ${colors.base}
label-unfocused-padding = 1

label-visible = %icon%
label-visible-foreground = ${colors.text}
label-visible-background = ${colors.base}
label-visible-padding = 1

label-urgent = %icon%
label-urgent-foreground = ${colors.base}
label-urgent-background = ${colors.red}
label-urgent-padding = 1

; ============================================================
;  MODULE: Date
; ============================================================
[module/date]
type = internal/date
interval = 1
locale = zh_CN.UTF-8

date = %A %p %I:%M

label = %date%
label-foreground = ${colors.text}
label-background = ${colors.base}
label-font = 2

; ============================================================
;  MODULE: System Tray (恢复默认)
; ============================================================
[module/tray]
type = internal/tray

; 去掉背景色设置，跟随 bar 的 background
format-background = ${colors.base}
tray-background = ${colors.base}
tray-foreground = ${colors.text}

tray-spacing = 8px
tray-size = 66%
format-padding = 0

# 设置主键
set $mod Mod4
# 字体设置
# font pango:Maple Mono NF CN 13
# font pango:Noto Sans CJK SC 13
font pango:Inter, HarmonyOS Sans SC 16
# 开机自动启动桌面
exec --no-startup-id dex --autostart --environment i3
exec_always --no-startup-id xrdb -merge ~/.Xresources
exec_always --no-startup-id dunst
# 锁屏
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork
# 权限
exec --no-startup-id lxpolkit
# 音量调整
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status
# 拖拽浮动窗口位置
floating_modifier $mod
# 终端绑定
bindsym $mod+Return exec  --no-startup-id ~/.local/share/alacritty/alacritty
# kill focused window
bindsym $mod+Shift+q kill
# 强制杀死
bindsym $mod+Ctrl+x exec --no-startup-id xkill
# rofi启动
bindsym $mod+d exec --no-startup-id rofi -show drun -run-shell-command '{terminal} -e bash -ic "{cmd} && read"'
# 使用 back_and_forth (在最近使用的两个窗口间反复横跳)
bindsym Mod1+Tab workspace back_and_forth

# change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in horizontal orientation
bindsym $mod+g split h

# split in vertical orientation
bindsym $mod+c split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+f floating toggle

# change focus between tiling / floating windows
# bindsym $mod+space focus mode_toggle

# 文件管理器
bindsym $mod+a exec --no-startup-id nemo

# 剪切板
#bindsym $mod+d focus child
exec --no-startup-id greenclip daemon>/dev/null
bindsym $mod+v exec --no-startup-id rofi -theme "~/.config/rofi/squared-everforest.rasi" -modi "clipboard:greenclip print" -show clipboard -run-command 'xdotool type --delay 0 "{cmd}"' 
# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# switch to workspace
bindsym $mod+1 workspace number $ws1 
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# reload the configuration file
bindsym $mod+Shift+c reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart
# sway关机 
bindsym $mod+o exec --no-startup-id  "bash ~/.config/rofi/powermenu/type-4/powermenu.sh"
# 截取全屏并保存到图片文件夹（以时间命名）
bindsym Print exec --no-startup-id  maim ~/Pictures/$(date +%s).png
# 截取全屏并直接复制到剪贴板
bindsym $mod+Print exec --no-startup-id  maim | xclip -selection clipboard -t image/png
# 鼠标拉取区域截图并复制到剪贴板（最常用）
bindsym Mod1+a exec --no-startup-id  maim -s | xclip -selection clipboard -t image/png
# resize window (you can also use the mouse for that)
mode "." {
        # These bindings trigger as soon as you enter the resize mode
        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym semicolon resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or $mod+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "."

# 开机启动
exec --no-startup-id fcitx5 &
exec --no-startup-id numlockx on
exec --no-startup-id feh --bg-fill ~/.config/i3/png/default.png
# exec_always --no-startup-id ~/.config/i3/script/wallpaper_daemon.sh
### Autostart
exec_always --no-startup-id autotiling -w 1 2 5 7 9
# exec --no-startup-id udiskie -t
exec_always --no-startup-id picom
# 启动触摸板手势服务
exec_always --no-startup-id libinput-gestures-setup start
# 启动 eww daemon
# exec_always --no-startup-id eww daemon
# exec_always --no-startup-id eww open bar
# 指定浮动
for_window [class="Localsend_app"] floating enable
for_window [class="org.gnome.FileRoller"] floating enable
for_window [class="Free Download Manager"] floating enable, resize set 1200 800, move position center
for_window [class="Image Lounge"] floating enable,resize set 1200 800, move position center
# for_window [class="Nemo"] floating enable,resize set 1200 800, move position center
for_window [class="ONLYOFFICE"] floating enable
for_window [class="matplotlib"] floating enable,resize set 1200 800, move position center
# for_window [class="Zathura"] floating enable,resize set 1200 800, move position center
for_window [class="wechat"] floating enable,resize set 1200 800, move position center

# 窗口间隙
gaps inner 5
gaps outer 2
# 窗口标题居中
title_align center
# 设置窗口边框
default_border pixel 0
default_floating_border pixel 0
hide_edge_borders smart
default_border none
# 启用智能间隙
# smart_gaps on

# ~/.config/direnv/direnvrc

# 定义 layout_anaconda 函数，适配 Miniforge3 路径
layout_anaconda() {
  local ACTIVATE="${HOME}/miniforge3/bin/activate"

  if [ -n "$1" ]; then
    # 显式指定环境名称
    local env_name="$1"
    source "$ACTIVATE" "$env_name"
  elif [ -f environment.yml ]; then
    # 自动从 environment.yml 读取环境名称
    local env_name=$(grep "name:" environment.yml | sed -e 's/name: //' | tr -d ' ' | head -n 1)
    source "$ACTIVATE" "$env_name"
  else
    echo "Error: No environment specified and no environment.yml found." >&2
  fi
}

# 如果你习惯叫它 layout_miniforge，可以加个别名
layout_miniforge() {
  layout_anaconda "$@"
}
